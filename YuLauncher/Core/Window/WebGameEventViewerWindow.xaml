<ui:FluentWindow x:Class="YuLauncher.Core.Window.WebGameEventViewerWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:lex="http://wpflocalizeextension.codeplex.com"
 lex:ResxLocalizationProvider.DefaultAssembly="YuLauncher" lex:ResxLocalizationProvider.DefaultDictionary="Language"
 Title="{lex:Loc WebGameEventViewer}" Width="1080" Height="720" MinWidth="900" MinHeight="640" ExtendsContentIntoTitleBar="True" WindowStartupLocation="CenterOwner" Closed="OnClosed">
 <Grid><Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="240"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <ui:TitleBar Title="{lex:Loc WebGameEventViewer}" Height="48"/>
 <StackPanel Grid.Row="1" Margin="12,6">
 <WrapPanel><ui:TextBox x:Name="EventFilterBox" Width="260" PlaceholderText="{lex:Loc WebGameEventFilter}" TextChanged="FilterChanged"/>
 <ui:Button x:Name="PauseEventObservationButton" Content="{lex:Loc WebGameEventPause}" Click="Pause" Margin="6,0"/>
 <ui:Button x:Name="ClearObservedEventsButton" Content="{lex:Loc WebGameEventClear}" Click="Clear"/></WrapPanel>
 <CheckBox x:Name="CaptureEventDetailCheckBox" Checked="DetailChanged" Unchecked="DetailChanged" Margin="0,6"><ui:TextBlock Text="{lex:Loc WebGameEventCaptureDetail}" Appearance="Primary"/></CheckBox>
 <ui:TextBlock x:Name="CountText" Appearance="Secondary"/>
 </StackPanel>
 <Grid Grid.Row="2" Margin="12,0"><TabControl x:Name="EventViewerTabs" SelectionChanged="SelectionChanged">
 <TabItem Header="{lex:Loc WebGameEventNetworkTab}"><DataGrid x:Name="NetworkEventsGrid" IsReadOnly="True" AutoGenerateColumns="False" EnableRowVirtualization="True" EnableColumnVirtualization="True" SelectionMode="Single" SelectionChanged="SelectionChanged"/></TabItem>
 <TabItem Header="{lex:Loc WebGameEventDomTab}"><DataGrid x:Name="DomEventsGrid" IsReadOnly="True" AutoGenerateColumns="False" EnableRowVirtualization="True" EnableColumnVirtualization="True" SelectionMode="Single" SelectionChanged="SelectionChanged"/></TabItem>
 </TabControl><ui:TextBlock x:Name="EmptyText" Text="{lex:Loc WebGameEventEmpty}" Appearance="Secondary" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/></Grid>
 <Grid Grid.Row="3" Margin="12,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <ui:Button x:Name="ReadEventJsonButton" Content="{lex:Loc WebGameEventReadJson}" Click="ReadJson" IsEnabled="False" HorizontalAlignment="Left"/>
 <TreeView x:Name="EventJsonTree" Grid.Row="1" SelectedItemChanged="JsonSelected" Margin="0,6" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
 <ui:TextBlock x:Name="DetailStateText" Grid.Row="2" Appearance="Secondary" TextWrapping="Wrap"/>
 </Grid>
 <ScrollViewer Grid.Column="1" Margin="12,0,0,0" VerticalScrollBarVisibility="Auto"><StackPanel>
 <StackPanel x:Name="NetworkRulePanel"><ui:TextBlock Text="{lex:Loc WebGameEventUrl}" Appearance="Primary"/><ui:TextBox x:Name="EventRuleUrlBox"/>
 <ui:TextBlock Text="{lex:Loc WebGameEventMethod}" Appearance="Primary"/><ui:TextBox x:Name="EventRuleMethodBox"/>
 <ui:TextBlock Text="{lex:Loc WebGameEventStatus}" Appearance="Primary"/><ui:TextBox x:Name="EventRuleStatusBox"/></StackPanel>
 <ui:TextBlock x:Name="DomTargetText" Appearance="Primary" TextWrapping="Wrap"/>
 <CheckBox x:Name="EventRuleUseJsonCheckBox" Margin="0,6"><ui:TextBlock Text="{lex:Loc WebGameEventUseJson}" Appearance="Primary"/></CheckBox>
 <ui:TextBlock Text="{lex:Loc WebGameEventJsonPointer}" Appearance="Primary"/><ui:TextBox x:Name="EventRuleJsonPointerBox"/>
 <ui:TextBlock Text="{lex:Loc WebGameEventExpectedJson}" Appearance="Primary"/><ui:TextBox x:Name="EventRuleExpectedJsonBox"/>
 </StackPanel></ScrollViewer></Grid>
 <ui:InfoBar x:Name="EventViewerErrorBar" Grid.Row="4" IsOpen="False" Severity="Error" Title="{lex:Loc CreateGameDialogErrorTitle}" Margin="12,0"/>
 <Grid Grid.Row="5" Margin="12,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel>
 <ui:TextBlock x:Name="ModeNoticeText" Appearance="Secondary" TextWrapping="Wrap"/>
 <ui:TextBlock Text="{lex:Loc WebGameEventPrivacyNotice}" Appearance="Secondary" TextWrapping="Wrap"/>
 <ui:TextBlock x:Name="ExistingScriptNoticeText" Text="{lex:Loc WebGameEventExistingScriptNotice}" Appearance="Secondary" TextWrapping="Wrap"/>
 </StackPanel><ui:Button x:Name="ApplyObservedEventButton" Grid.Column="1" Content="{lex:Loc WebGameEventApply}" Click="Apply" Appearance="Primary" IsEnabled="False" Margin="12,0,0,0" VerticalAlignment="Bottom"/></Grid>
 </Grid>
</ui:FluentWindow>
