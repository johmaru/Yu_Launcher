<Page x:Class="YuLauncher.Core.Window.Pages.Settings.General"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:YuLauncher.Core.Window.Pages.Settings"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:lex="http://wpflocalizeextension.codeplex.com"
      lex:LocalizeDictionary.DesignCulture="ja-JP"
      lex:ResxLocalizationProvider.DefaultAssembly="YuLauncher"
      lex:ResxLocalizationProvider.DefaultDictionary="Language"
      Loaded="General_OnLoaded"
      mc:Ignorable="d"
      d:DesignHeight="300" d:DesignWidth="300">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,12">
                <ui:TextBlock x:Name="GeneralTextBlock" Text="{lex:Loc SimpleGeneral}"  Margin="0,0,0,30" HorizontalAlignment="Center"
                              FontSize="20" FontWeight="Bold" Appearance="Primary"/>
                <ui:TextBlock x:Name="VersionTextBlock" Text="{Binding NowVersion}" Margin="0,0,0,30" HorizontalAlignment="Center"
                              FontSize="15" FontWeight="Bold" Appearance="Primary"/>

                <!-- AppData セクション -->
                <Border BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="16,0,16,12"
                        Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Column="0" Text="{lex:Loc SimpleAppData}" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0" Appearance="Primary"/>
                        <Border x:Name="AppDataDivider" Grid.Column="1" Background="{DynamicResource DividerBrush}" Margin="0,0,12,0" HorizontalAlignment="Stretch"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button x:Name="AppExportBtn" Margin="0,0,12,0" Content="{lex:Loc SimpleExport}" Click="ExportBtn_OnClick"/>
                            <Button x:Name="AppImportBtn" Content="{lex:Loc SimpleImport}" Click="AppImportBtn_OnClick"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 区切り線色設定セクション -->
                <Border BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="16,0,16,12"
                        Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Column="0" Text="{lex:Loc SettingsDividerColor}"
                                      VerticalAlignment="Center"
                                      FontSize="15"
                                      Margin="0,0,12,0"
                                      Appearance="Primary"/>
                        <Border x:Name="ColorSettingDivider" Grid.Column="1" Background="{DynamicResource DividerBrush}" Margin="0,0,12,0" HorizontalAlignment="Stretch"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Left">
                            <ui:TextBox x:Name="DividerColorBox"
                                        Width="120"
                                        PlaceholderText="{lex:Loc SettingsDividerColorPlaceholder}"
                                        Margin="0,0,12,0"/>
                            <Border x:Name="DividerColorPreview"
                                    Width="32" Height="32"
                                    CornerRadius="4"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource DividerBrush}"
                                    Background="{DynamicResource DividerBrush}"
                                    Margin="0,0,12,0"/>
                            <ui:Button x:Name="DividerColorApplyBtn"
                                       Content="{lex:Loc SettingsDividerColorApply}"
                                       Click="DividerColorApplyBtn_OnClick"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
