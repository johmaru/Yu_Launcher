<Page x:Class="YuLauncher.Core.Window.Pages.SettingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:properties="clr-namespace:YuLauncher.Properties"
      xmlns:cal="http://www.caliburnproject.org"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:lex="http://wpflocalizeextension.codeplex.com"
      lex:LocalizeDictionary.DesignCulture="ja-JP"
      lex:ResxLocalizationProvider.DefaultAssembly="YuLauncher"
      lex:ResxLocalizationProvider.DefaultDictionary="Language"
      Loaded="SettingPage_OnLoaded"
      mc:Ignorable="d">
    

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="24,12">
            <ToggleButton x:Name="GeneralItem" Content="{lex:Loc SimpleGeneral}"
                          Click="GeneralItem_OnClick" Padding="16,8" Margin="0,0,8,0"/>
            <ToggleButton x:Name="VideoVisualItem" Content="{lex:Loc VideoGraphics}"
                          Click="VideoVisualItem_OnClick" Padding="16,8"/>
        </StackPanel>
        <Frame x:Name="ContentFrame" Grid.Row="1" NavigationUIVisibility="Hidden"
               HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
    </Grid>
</Page>