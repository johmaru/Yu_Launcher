<local:DialogInterface x:Class="YuLauncher.Core.Window.Pages.XamlCreateGameDialogInterface.Web"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:YuLauncher.Core.Window.Pages.XamlCreateGameDialogInterface"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:lex="http://wpflocalizeextension.codeplex.com"
             lex:LocalizeDictionary.DesignCulture="ja-JP"
             lex:ResxLocalizationProvider.DefaultAssembly="YuLauncher"
             lex:ResxLocalizationProvider.DefaultDictionary="Language"
             Loaded="Web_OnLoaded"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <StackPanel Margin="24,16,24,16">
                <ui:Card Padding="16" Margin="0,0,0,12" HorizontalAlignment="Stretch">
                    <StackPanel>
                        <ui:TextBlock Text="{lex:Loc PropertyBasicInfo}" FontSize="16" FontWeight="SemiBold"
                                      Appearance="Primary" Margin="0,0,0,12"/>
                        <ui:TextBlock x:Name="NameTextBlock" Text="{lex:Loc SimpleName}" FontSize="13"
                                      Appearance="Primary" TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <ui:TextBox x:Name="NameBox" PlaceholderText="{lex:Loc NameInput}"
                                    HorizontalAlignment="Stretch" MinHeight="36" Margin="0,0,0,12"
                                    AutomationProperties.AutomationId="NameBox"
                                    AutomationProperties.LabeledBy="{Binding ElementName=NameTextBlock}"/>
                        <ui:TextBlock x:Name="UrlTextBlock" Text="{lex:Loc SimpleAddress}" FontSize="13"
                                      Appearance="Primary" TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <ui:TextBox x:Name="UrlBox" HorizontalAlignment="Stretch" MinHeight="36"
                                    AutomationProperties.AutomationId="UrlBox"
                                    AutomationProperties.LabeledBy="{Binding ElementName=UrlTextBlock}"/>
                    </StackPanel>
                </ui:Card>
                <ui:Card Padding="16" Margin="0,0,0,12" HorizontalAlignment="Stretch">
                    <StackPanel>
                        <ui:TextBlock Text="{lex:Loc PropertyLaunchSettings}" FontSize="16" FontWeight="SemiBold"
                                      Appearance="Primary" Margin="0,0,0,12"/>
                        <ui:ToggleSwitch x:Name="WebviewSwitch" Content="{lex:Loc SimpleUseWebview}" Margin="0,0,0,12"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <ui:TextBlock x:Name="WindowWidthTextBlock" Text="{lex:Loc SimpleWindowWidth}"
                                              FontSize="13" Appearance="Primary" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <ui:NumberBox x:Name="WindowWidthBox" PlaceholderText="{lex:Loc SimpleWindowSize}"
                                              ClearButtonEnabled="True" Minimum="800" HorizontalAlignment="Stretch"
                                              AutomationProperties.LabeledBy="{Binding ElementName=WindowWidthTextBlock}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <ui:TextBlock x:Name="WindowHeightTextBlock" Text="{lex:Loc SimpleWindowHeight}"
                                              FontSize="13" Appearance="Primary" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <ui:NumberBox x:Name="WindowHeightBox" PlaceholderText="{lex:Loc SimpleWindowSize}"
                                              ClearButtonEnabled="True" Minimum="400" HorizontalAlignment="Stretch"
                                              AutomationProperties.LabeledBy="{Binding ElementName=WindowHeightTextBlock}"/>
                            </StackPanel>
                        </Grid>
                        <Expander IsExpanded="False" HorizontalContentAlignment="Stretch">
                            <Expander.Header>
                                <ui:TextBlock x:Name="MultipleLaunchText" Text="{lex:Loc MultipleLaunchText}"
                                              Appearance="Primary" TextWrapping="Wrap"/>
                            </Expander.Header>
                            <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding Candidates, RelativeSource={RelativeSource AncestorType=local:DialogInterface}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Margin="0,2,0,2" HorizontalContentAlignment="Stretch"
                                                      IsChecked="{Binding IsChecked, Mode=TwoWay}" AutomationProperties.Name="{Binding Name}">
                                                <CheckBox.Content>
                                                    <ui:TextBlock Text="{Binding Name}" Appearance="Primary" TextWrapping="Wrap"/>
                                                </CheckBox.Content>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Expander>
                    </StackPanel>
                </ui:Card>
                <ui:Card Padding="16" Margin="0" HorizontalAlignment="Stretch">
                    <StackPanel>
                        <ui:TextBlock Text="{lex:Loc PropertyRelatedSettings}" FontSize="16" FontWeight="SemiBold"
                                      Appearance="Primary" Margin="0,0,0,12"/>
                        <ui:Button x:Name="GenreManageButton" Content="{lex:Loc SimpleGenreManage}"
                                   AutomationProperties.AutomationId="GenreManageButton" Click="GenreManageButton_OnClick"/>
                    </StackPanel>
                </ui:Card>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerBrush}" Padding="24,12,24,12">
            <ui:Button x:Name="SaveButton" Content="{lex:Loc PropertySaveChanges}" Appearance="Primary"
                       HorizontalAlignment="Right" MinHeight="36" Padding="20,8"
                       AutomationProperties.AutomationId="SaveButton" Click="SaveButton_OnClick"/>
        </Border>
    </Grid>
</local:DialogInterface>
