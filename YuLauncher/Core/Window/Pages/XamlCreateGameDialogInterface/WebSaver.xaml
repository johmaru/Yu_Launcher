<local:DialogInterface x:Class="YuLauncher.Core.Window.Pages.XamlCreateGameDialogInterface.WebSaver"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:YuLauncher.Core.Window.Pages.XamlCreateGameDialogInterface"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:lex="http://wpflocalizeextension.codeplex.com"
             lex:LocalizeDictionary.DesignCulture="ja-JP"
             lex:ResxLocalizationProvider.DefaultAssembly="YuLauncher"
             lex:ResxLocalizationProvider.DefaultDictionary="Language"
             Loaded="WebSaver_OnLoaded"
             mc:Ignorable="d">
    <Grid Margin="16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 名前 -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ui:TextBlock Grid.Column="0" x:Name="NameTextBlock"
                          Text="{lex:Loc SimpleName}"
                          VerticalAlignment="Center"
                          Margin="0,0,12,0"
                          Appearance="Primary"/>
            <ui:TextBox Grid.Column="1" x:Name="NameBox"
                        PlaceholderText="{lex:Loc NameInput}"/>
        </Grid>

        <!-- URL -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ui:TextBlock Grid.Column="0" x:Name="UrlTextBlock"
                          Text="{lex:Loc SimpleAddress}"
                          VerticalAlignment="Center"
                          Margin="0,0,12,0"
                          Appearance="Primary"/>
            <ui:TextBox Grid.Column="1" x:Name="UrlBox"/>
        </Grid>

        <!-- WebView トグル -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <ui:ToggleSwitch x:Name="WebviewSwitch"
                            Content="{lex:Loc SimpleUseWebview}"/>
        </Grid>

        <!-- 複数起動 -->
        <Grid Grid.Row="3" Margin="0,0,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ui:TextBlock Grid.Row="0" x:Name="MultipleLaunchText"
                          Text="{lex:Loc MultipleLaunchText}"
                          Margin="0,0,0,4"
                          Appearance="Primary"/>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="200">
                <ItemsControl ItemsSource="{Binding Candidates, RelativeSource={RelativeSource AncestorType=local:DialogInterface}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Margin="0,2,0,2"
                                      IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                      Content="{Binding Name}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- ジャンル管理 -->
        <Grid Grid.Row="4" Margin="0,0,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ui:TextBlock Grid.Row="0"
                          Text="{lex:Loc SimpleGenreManage}"
                          Margin="0,0,0,4"
                          Appearance="Primary"/>
            <ui:Button Grid.Row="1"
                       x:Name="GenreManageButton"
                       Content="{lex:Loc SimpleManage}"
                       Click="GenreManageButton_OnClick"/>
        </Grid>

        <!-- ウィンドウサイズ -->
        <Grid Grid.Row="5" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ui:TextBlock Grid.Column="0" Text="{lex:Loc SimpleWindowWidth}"
                          VerticalAlignment="Center"
                          Margin="0,0,8,0"
                          Appearance="Primary"/>
            <ui:NumberBox Grid.Column="1" x:Name="WindowWidthBox"
                          PlaceholderText="{lex:Loc SimpleWindowSize}"
                          ClearButtonEnabled="True"
                          Minimum="800"/>
            <ui:TextBlock Grid.Column="2" Text="{lex:Loc SimpleWindowHeight}"
                          VerticalAlignment="Center"
                          Margin="16,0,8,0"
                          Appearance="Primary"/>
            <ui:NumberBox Grid.Column="3" x:Name="WindowHeightBox"
                          PlaceholderText="{lex:Loc SimpleWindowSize}"
                          ClearButtonEnabled="True"
                          Minimum="400"/>
        </Grid>

        <!-- 保存ボタン -->
        <StackPanel Grid.Row="8"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <ui:Button x:Name="SaveButton"
                       Content="{lex:Loc SimpleSave}"
                       Click="SaveButton_OnClick"/>
        </StackPanel>
    </Grid>
</local:DialogInterface>
