<ui:FluentWindow x:Class="YuLauncher.Core.Window.Pages.CreateGameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:YuLauncher.Core.Window.Pages"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:lex="http://wpflocalizeextension.codeplex.com"
        lex:LocalizeDictionary.DesignCulture="ja-JP"
        lex:ResxLocalizationProvider.DefaultAssembly="YuLauncher"
        lex:ResxLocalizationProvider.DefaultDictionary="Language"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="{lex:Loc CreateGameDialogTitle}"
        Width="640" Height="520"
        MinWidth="560" MinHeight="460"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">
    <ui:FluentWindow.Resources>
        <Style TargetType="{x:Type TabControl}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabControl}">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TabPanel x:Name="HeaderPanel"
                                      Grid.Row="0"
                                      Margin="0"
                                      Panel.ZIndex="1"
                                      Background="Transparent"
                                      IsItemsHost="True"
                                      KeyboardNavigation.TabIndex="1"/>
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              Grid.Row="1"
                                              Margin="0,16,0,0"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch"
                                              ContentSource="SelectedContent"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>
    <Grid Margin="1">
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,0,1">
            <ui:TitleBar Title="{lex:Loc CreateGameDialogTitle}"
                         Height="48"/>
        </Border>

        <TabControl x:Name="EntryTypeTabControl"
                    Grid.Row="1"
                    TabStripPlacement="Top"
                    Margin="24,16,24,0"
                    Padding="0">
            <TabItem x:Name="ApplicationTab" Header="{lex:Loc TabHeaderApplication}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <ui:Card Padding="16" BorderThickness="0" HorizontalAlignment="Stretch">
                            <StackPanel>
                                <ui:TextBlock Text="{lex:Loc SimpleName}" FontSize="13" FontWeight="SemiBold"
                                              Appearance="Primary" Margin="0,0,0,6"/>
                                <ui:TextBox x:Name="AppNameBox" PlaceholderText="{lex:Loc NameInput}"
                                            AutomationProperties.Name="{lex:Loc SimpleName}" Margin="0,0,0,16"/>
                                <ui:TextBlock Text="{lex:Loc AddEntryFileLabel}" FontSize="13" FontWeight="SemiBold"
                                              Appearance="Primary" Margin="0,0,0,6"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ui:Button Grid.Column="0" x:Name="AppFileButton" Content="{lex:Loc SelectFileLabel}"
                                               Click="AppFileButton_OnClick" Margin="0,0,12,0" MinHeight="36"/>
                                    <ui:TextBlock Grid.Column="1" x:Name="AppPathLabel" Appearance="Secondary"
                                                  TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                  VerticalAlignment="Center"
                                                  ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                </Grid>
                                <ui:TextBlock Text="{lex:Loc GenreApplication}" Appearance="Secondary" FontSize="12"
                                              TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </StackPanel>
                        </ui:Card>
                        <ui:TextBlock Text="{lex:Loc ApplicationTabDescription}" Appearance="Secondary" FontSize="13"
                                      TextWrapping="Wrap" Margin="0,12,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="WebSiteTab" Header="{lex:Loc TabHeaderWebSite}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <ui:Card Padding="16" BorderThickness="0" HorizontalAlignment="Stretch">
                            <StackPanel>
                                <ui:TextBlock Text="{lex:Loc SimpleName}" FontSize="13" FontWeight="SemiBold"
                                              Appearance="Primary" Margin="0,0,0,6"/>
                                <ui:TextBox x:Name="WebSiteNameBox" PlaceholderText="{lex:Loc NameInput}"
                                            AutomationProperties.Name="{lex:Loc SimpleName}" Margin="0,0,0,16"/>
                                <ui:TextBlock Text="{lex:Loc SimpleAddress}" FontSize="13" FontWeight="SemiBold"
                                              Appearance="Primary" Margin="0,0,0,6"/>
                                <ui:TextBox x:Name="WebSiteUrlBox" PlaceholderText="{lex:Loc PleaseURL}"
                                            AutomationProperties.Name="{lex:Loc SimpleAddress}"/>
                            </StackPanel>
                        </ui:Card>
                        <ui:TextBlock Text="{lex:Loc WebSiteTabDescription}" Appearance="Secondary" FontSize="13"
                                      TextWrapping="Wrap" Margin="0,12,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="WebGameTab" Header="{lex:Loc TabHeaderWebGame}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <ui:Card Padding="16" BorderThickness="0" HorizontalAlignment="Stretch">
                            <StackPanel>
                                <ui:TextBlock Text="{lex:Loc SimpleName}" FontSize="13" FontWeight="SemiBold"
                                              Appearance="Primary" Margin="0,0,0,6"/>
                                <ui:TextBox x:Name="WebGameNameBox" PlaceholderText="{lex:Loc NameInput}"
                                            AutomationProperties.Name="{lex:Loc SimpleName}" Margin="0,0,0,16"/>
                                <ui:TextBlock Text="{lex:Loc SimpleAddress}" FontSize="13" FontWeight="SemiBold"
                                              Appearance="Primary" Margin="0,0,0,6"/>
                                <ui:TextBox x:Name="WebGameUrlBox" PlaceholderText="{lex:Loc PleaseURL}"
                                            AutomationProperties.Name="{lex:Loc SimpleAddress}"/>
                            </StackPanel>
                        </ui:Card>
                        <ui:TextBlock Text="{lex:Loc WebGameTabDescription}" Appearance="Secondary" FontSize="13"
                                      TextWrapping="Wrap" Margin="0,12,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="WebSaverTab" Header="{lex:Loc TabHeaderWebSaver}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <ui:Card Padding="16" BorderThickness="0" HorizontalAlignment="Stretch">
                            <StackPanel>
                                <ui:TextBlock Text="{lex:Loc SimpleName}" FontSize="13" FontWeight="SemiBold"
                                              Appearance="Primary" Margin="0,0,0,6"/>
                                <ui:TextBox x:Name="WebSaverNameBox" PlaceholderText="{lex:Loc NameInput}"
                                            AutomationProperties.Name="{lex:Loc SimpleName}" Margin="0,0,0,16"/>
                                <ui:TextBlock Text="{lex:Loc SimpleAddress}" FontSize="13" FontWeight="SemiBold"
                                              Appearance="Primary" Margin="0,0,0,6"/>
                                <ui:TextBox x:Name="WebSaverUrlBox" PlaceholderText="{lex:Loc PleaseURL}"
                                            AutomationProperties.Name="{lex:Loc SimpleAddress}"/>
                            </StackPanel>
                        </ui:Card>
                        <ui:InfoBar x:Name="WebSaverNoteBar" Title="{lex:Loc WebSaverDownloadNote}"
                                    IsOpen="True" Severity="Informational" IsClosable="False" Margin="0,12,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        <!-- 共通エラー表示 -->
        <ui:InfoBar Grid.Row="2"
                    x:Name="ErrorInfoBar"
                    IsOpen="False"
                    Severity="Error"
                    IsClosable="True"
                    Margin="24,12,24,0"/>

        <!-- 作成ボタン -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="24,16,24,16">
            <ui:Button x:Name="CreateButton"
                       MinHeight="36"
                       MinWidth="96"
                       Content="{lex:Loc CreateButton}"
                       Appearance="Primary"
                       Click="CreateButton_OnClick"/>
        </StackPanel>

    </Grid>
</ui:FluentWindow>
