<ui:FluentWindow x:Class="YuLauncher.Core.Window.Pages.CreateGameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:YuLauncher.Core.Window.Pages"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:lex="http://wpflocalizeextension.codeplex.com"
        lex:LocalizeDictionary.DesignCulture="ja-JP"
        lex:ResxLocalizationProvider.DefaultAssembly="YuLauncher"
        lex:ResxLocalizationProvider.DefaultDictionary="Language"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="{lex:Loc CreateGameDialogTitle}"
        Width="640" Height="520"
        MinWidth="560" MinHeight="460"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">
    <ui:FluentWindow.Resources>
        <Style TargetType="{x:Type TabControl}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabControl}">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TabPanel x:Name="HeaderPanel"
                                      Grid.Row="0"
                                      Margin="0"
                                      Panel.ZIndex="1"
                                      Background="Transparent"
                                      IsItemsHost="True"
                                      KeyboardNavigation.TabIndex="1"/>
                            <Border Grid.Row="1"
                                    Height="1"
                                    Background="{DynamicResource DividerBrush}"/>
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="1"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0"
                                        Background="{DynamicResource DividerBrush}"/>
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  Grid.Column="1"
                                                  Margin="0"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Stretch"
                                                  ContentSource="SelectedContent"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                                <Border Grid.Column="2"
                                        Background="{DynamicResource DividerBrush}"/>
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>
    <Grid Margin="1">
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,0,1">
            <ui:TitleBar Title="{lex:Loc CreateGameDialogTitle}"
                         Height="48"/>
        </Border>

        <!-- タブ領域: 枠線なし（枠線はTabControlテンプレート内で管理） -->
        <Border Grid.Row="2"
                Background="Transparent">
            <TabControl x:Name="EntryTypeTabControl"
                        TabStripPlacement="Top"
                        Margin="0"
                        Padding="0">
            <TabItem x:Name="ApplicationTab"
                     Header="{lex:Loc TabHeaderApplication}">
                <StackPanel Margin="0,16,0,0">
                    <!-- 名前 -->
                    <Border BorderBrush="{DynamicResource DividerBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="20,0,20,16"
                            Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ui:TextBlock Grid.Column="0"
                                          Text="{lex:Loc SimpleName}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,16,0"
                                          Appearance="Primary"/>
                            <ui:TextBox Grid.Column="1"
                                        x:Name="AppNameBox"
                                        PlaceholderText="{lex:Loc NameInput}"/>
                        </Grid>
                    </Border>

                    <!-- ファイル選択 -->
                    <Border BorderBrush="{DynamicResource DividerBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="20,0,20,16"
                            Margin="0,0,0,20">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ui:Button Grid.Column="0"
                                           x:Name="AppFileButton"
                                           Content="{lex:Loc SelectFileLabel}"
                                           Click="AppFileButton_OnClick"
                                           Margin="0,0,12,0"/>
                                <ui:TextBlock Grid.Column="1"
                                              x:Name="AppPathLabel"
                                              VerticalAlignment="Center"
                                              TextWrapping="NoWrap"
                                              TextTrimming="CharacterEllipsis"
                                              Appearance="Secondary"/>
                            </Grid>
                            <ui:TextBlock Text="{lex:Loc GenreApplication}"
                                          Appearance="Tertiary"
                                          FontSize="11"/>
                        </StackPanel>
                    </Border>

                    <!-- 説明 -->
                    <ui:TextBlock Text="{lex:Loc ApplicationTabDescription}"
                                  Appearance="Secondary"
                                  TextWrapping="Wrap"
                                  Margin="20,0,20,0"/>
                </StackPanel>
            </TabItem>

            <TabItem x:Name="WebSiteTab"
                     Header="{lex:Loc TabHeaderWebSite}">
                <StackPanel Margin="0,16,0,0">
                    <!-- 名前 -->
                    <Border BorderBrush="{DynamicResource DividerBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="20,0,20,16"
                            Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ui:TextBlock Grid.Column="0"
                                          Text="{lex:Loc SimpleName}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,16,0"
                                          Appearance="Primary"/>
                            <ui:TextBox Grid.Column="1"
                                        x:Name="WebSiteNameBox"
                                        PlaceholderText="{lex:Loc NameInput}"/>
                        </Grid>
                    </Border>

                    <!-- URL -->
                    <Border BorderBrush="{DynamicResource DividerBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="20,0,20,16"
                            Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ui:TextBlock Grid.Column="0"
                                          Text="{lex:Loc SimpleAddress}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,16,0"
                                          Appearance="Primary"/>
                            <ui:TextBox Grid.Column="1"
                                        x:Name="WebSiteUrlBox"
                                        PlaceholderText="{lex:Loc PleaseURL}"/>
                        </Grid>
                    </Border>

                    <!-- 説明 -->
                    <ui:TextBlock Text="{lex:Loc WebSiteTabDescription}"
                                  Appearance="Secondary"
                                  TextWrapping="Wrap"
                                  Margin="20,0,20,0"/>
                </StackPanel>
            </TabItem>

            <TabItem x:Name="WebGameTab"
                     Header="{lex:Loc TabHeaderWebGame}">
                <StackPanel Margin="0,16,0,0">
                    <!-- 名前 -->
                    <Border BorderBrush="{DynamicResource DividerBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="20,0,20,16"
                            Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ui:TextBlock Grid.Column="0"
                                          Text="{lex:Loc SimpleName}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,16,0"
                                          Appearance="Primary"/>
                            <ui:TextBox Grid.Column="1"
                                        x:Name="WebGameNameBox"
                                        PlaceholderText="{lex:Loc NameInput}"/>
                        </Grid>
                    </Border>

                    <!-- URL -->
                    <Border BorderBrush="{DynamicResource DividerBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="20,0,20,16"
                            Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ui:TextBlock Grid.Column="0"
                                          Text="{lex:Loc SimpleAddress}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,16,0"
                                          Appearance="Primary"/>
                            <ui:TextBox Grid.Column="1"
                                        x:Name="WebGameUrlBox"
                                        PlaceholderText="{lex:Loc PleaseURL}"/>
                        </Grid>
                    </Border>

                    <!-- 説明 -->
                    <ui:TextBlock Text="{lex:Loc WebGameTabDescription}"
                                  Appearance="Secondary"
                                  TextWrapping="Wrap"
                                  Margin="20,0,20,0"/>
                </StackPanel>
            </TabItem>

            <TabItem x:Name="WebSaverTab"
                     Header="{lex:Loc TabHeaderWebSaver}">
                <StackPanel Margin="0,16,0,0">
                    <!-- 名前 -->
                    <Border BorderBrush="{DynamicResource DividerBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="20,0,20,16"
                            Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ui:TextBlock Grid.Column="0"
                                          Text="{lex:Loc SimpleName}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,16,0"
                                          Appearance="Primary"/>
                            <ui:TextBox Grid.Column="1"
                                        x:Name="WebSaverNameBox"
                                        PlaceholderText="{lex:Loc NameInput}"/>
                        </Grid>
                    </Border>

                    <!-- URL -->
                    <Border BorderBrush="{DynamicResource DividerBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="20,0,20,16"
                            Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ui:TextBlock Grid.Column="0"
                                          Text="{lex:Loc SimpleAddress}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,16,0"
                                          Appearance="Primary"/>
                            <ui:TextBox Grid.Column="1"
                                        x:Name="WebSaverUrlBox"
                                        PlaceholderText="{lex:Loc PleaseURL}"/>
                        </Grid>
                    </Border>

                    <!-- 注意書き -->
                    <ui:InfoBar x:Name="WebSaverNoteBar"
                                Title="{lex:Loc WebSaverDownloadNote}"
                                IsOpen="True"
                                Severity="Informational"
                                IsClosable="False"
                                Margin="20,0,20,0"/>
                </StackPanel>
            </TabItem>
        </TabControl>
        </Border>


        <!-- Createボタン上の横線 -->
        <Border Grid.Row="3"
                Height="1"
                VerticalAlignment="Top"
                Background="{DynamicResource DividerBrush}"/>

        <!-- 左縦線: Row 3-4（Createボタン下まで） -->
        <Border Grid.Row="3"
                Grid.RowSpan="2"
                Width="1"
                HorizontalAlignment="Left"
                Background="{DynamicResource DividerBrush}"/>
        <!-- 右縦線: Row 3-4（Createボタン下まで） -->
        <Border Grid.Row="3"
                Grid.RowSpan="2"
                Width="1"
                HorizontalAlignment="Right"
                Background="{DynamicResource DividerBrush}"/>

        <!-- 共通エラー表示 -->
        <ui:InfoBar Grid.Row="3"
                    x:Name="ErrorInfoBar"
                    IsOpen="False"
                    Severity="Error"
                    IsClosable="True"
                    Margin="16,8,16,0"/>

        <!-- 作成ボタン -->
        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="16,8">
            <ui:Button x:Name="CreateButton"
                       Content="{lex:Loc CreateButton}"
                       Appearance="Primary"
                       Click="CreateButton_OnClick"/>
        </StackPanel>

        <!-- Createボタン下の横線 -->
        <Border Grid.Row="4"
                Height="1"
                VerticalAlignment="Bottom"
                Background="{DynamicResource DividerBrush}"/>
    </Grid>
</ui:FluentWindow>
