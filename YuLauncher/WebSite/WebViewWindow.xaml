<ui:FluentWindow x:Class="YuLauncher.WebSite.WebViewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:YuLauncher.WebSite"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:lex="http://wpflocalizeextension.codeplex.com"
        lex:LocalizeDictionary.DesignCulture="ja-JP"
        lex:ResxLocalizationProvider.DefaultAssembly="YuLauncher"
        WindowStartupLocation="CenterScreen"
        mc:Ignorable="d"
        Closing="WebViewWindow_OnClosing"
        Title="WebViewWindow"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,0,1">
            <ui:TitleBar Title="{Binding Title, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                         Height="48">
                <ui:TitleBar.Header>
                    <Menu FontSize="12">
                        <MenuItem Header="機能">
                        </MenuItem>
                        <MenuItem Header="アプリケーション">
                            <MenuItem Header="設定"/>
                        </MenuItem>
                    </Menu>
                </ui:TitleBar.Header>
            </ui:TitleBar>
        </Border>
        <wv2:WebView2 Grid.Row="1" Name="webView"/>
    </Grid>
</ui:FluentWindow>
